{
  "name": "sc200-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Simulacro independiente SC-200: 563 preguntas en español, sin dependencias en tiempo de ejecución.",
  "scripts": {
    "test": "node --test tests/core.test.js",
    "test:browser": "node tests/e2e.mjs",
    "check:notes": "python3 tests/verify-notes.py",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "coverage": "node tests/coverage.js",
    "check:sources": "python3 tests/check_sources.py"
  },
  "devDependencies": {
    "playwright-core": "1.62.0"
  }
}
